{
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "installCommand": "npm install",
  "headers": [
    { "source": "/(sw.js|workbox-.*\.js|index.html|manifest.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/_nuxt/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sw.js", "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }] }
  ]
}
