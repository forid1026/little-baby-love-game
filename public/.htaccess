# Hostinger / Apache: sensible caching + correct types for the PWA
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  # Hashed build files (/_nuxt/*) never change
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate the entry points and service worker so updates show up
  # (this block comes last so it wins over the rule above)
  <FilesMatch "^(sw\.js|workbox-.*\.js|index\.html|200\.html|404\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
